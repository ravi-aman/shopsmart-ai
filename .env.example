# Copy to .env in the repo root. Only the first two are required; the rest have sensible defaults.

# --- Required ---
# MongoDB Atlas: Database → Connect → Drivers
MONGODB_URI=
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=

# --- AI (leave empty to run on the non-AI fallbacks) ---
NVIDIA_API_KEY=

# --- Ports & URLs ---
PORT=8080
# Where the Vite dev server sends /api
VITE_BACKEND_URL=http://127.0.0.1:8080
# Frontend URL(s) allowed to call the API (comma-separated). Set to your real domain when deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Used for links in emails
CLIENT_URL=http://localhost:5173

# --- Deployment ---
# Set to production when deployed
NODE_ENV=development
# Password for the demo accounts (basic@, prime@, premium@, admin@, ops@, partner@shopsmart.dev)
DEMO_USER_PASSWORD=ShopSmart@2026

# --- Optional email (without it, emails are logged and skipped) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
