# Copy to .env (repo root) and fill in. The API and the frontend both read this one file.

# ---------- MongoDB ----------
# MongoDB Atlas: Database → Connect → Drivers. Atlas gives transactions, Atlas Search and Vector Search.
# Local: `docker compose -f infra/docker-compose.yml up -d mongo` and use
#   mongodb://shopsmart:shopsmart@127.0.0.1:27017/?directConnection=true&authSource=admin
# A standalone mongod (no replica set) also works, without transactions or Atlas Search.
MONGODB_URI=
MONGODB_DB=shopsmart

# ---------- NVIDIA API (build.nvidia.com → Get API Key) ----------
# Leave empty to run with deterministic fallbacks (rules, keyword search, extractive answers).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MAX_TOKENS=2048
NVIDIA_EMBEDDING_MODEL=nvidia/embed-qa-4
# Must match the vector search indexes (products_vector, chunks_vector)
EMBEDDING_DIMENSIONS=1024
# true only for Matryoshka models that accept a `dimensions` field
EMBEDDING_SEND_DIMENSIONS=false
# Cost estimate per 1M tokens (USD) for the AI usage dashboard
AI_INPUT_COST_PER_1M=0.1
AI_OUTPUT_COST_PER_1M=0.4

# ---------- API ----------
PORT=8080
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=720
# Password for the seeded demo accounts (basic@, prime@, premium@, admin@, ops@, partner@shopsmart.dev)
DEMO_USER_PASSWORD=ShopSmart@2026
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Enables GET /api/health/ai (calls NVIDIA). Keep false in production.
DEV_ENDPOINTS_ENABLED=false
LOG_LEVEL=info

# ---------- Background jobs ----------
# Run jobs on exactly one instance when scaling out.
JOBS_ENABLED=true
SIMULATOR_ENABLED=true
SIMULATOR_STEP_SECONDS=180
EXPIRY_JOB_INTERVAL_MS=900000
# NGO / cold-storage partners must be within this radius of the fulfilment centre
PARTNER_RADIUS_METERS=3000
PARTNER_OFFER_HOURS=12

# ---------- Limits & currency ----------
AI_RATE_LIMIT_PER_MINUTE=15
AI_DAILY_LIMIT_BASIC=50
AI_DAILY_LIMIT_PREMIUM=300
# ₹ budgets in chat are converted with this rate (catalogue prices are in USD)
INR_PER_USD=83

# ---------- Email (optional; without SMTP, emails are logged as SKIPPED) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopSmart <no-reply@shopsmart.dev>
CLIENT_URL=http://localhost:5173

# ---------- Frontend ----------
# Where the Vite dev server proxies /api
VITE_BACKEND_URL=http://127.0.0.1:8080
