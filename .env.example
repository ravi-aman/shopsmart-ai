# Copy to .env (repo root) and fill in. Both apps read this one file.

# ---------- Supabase Postgres ----------
# Supabase dashboard → Connect → "Session pooler" (port 5432). Convert to JDBC form:
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Pooler user is "postgres.<project-ref>"
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_POOL_SIZE=5

# Optional: only needed if documents are stored in Supabase Storage instead of local disk
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge-docs

# ---------- NVIDIA API (build.nvidia.com → Get API Key) ----------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MAX_TOKENS=2048
NVIDIA_EMBEDDING_MODEL=nvidia/embed-qa-4
# Must match vector(1024) in V1__schema.sql
EMBEDDING_DIMENSIONS=1024
# true only for Matryoshka models that accept a `dimensions` field
EMBEDDING_SEND_DIMENSIONS=false

# ---------- Backend ----------
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_TTL_MINUTES=720
# Password for the seeded demo accounts (basic@, prime@, premium@, admin@, ops@shopsmart.dev)
DEMO_USER_PASSWORD=ShopSmart@2026
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Enables GET /api/health/ai (calls NVIDIA). Keep false in production.
DEV_ENDPOINTS_ENABLED=true

# ---------- Frontend ----------
VITE_BACKEND_URL=http://127.0.0.1:8080

# ---------- Simulation & limits ----------
AI_RATE_LIMIT_PER_MINUTE=15
SIMULATOR_ENABLED=true
SIMULATOR_STEP_SECONDS=180
